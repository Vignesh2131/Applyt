{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "sourceMap": true,

    "types": ["node", "express"]
  },

  "include": [
    "index.ts",
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "lib/**/*.ts",
    "generated/prisma/**/*.ts",
     "**/*.d.ts"
  ],

  "exclude": ["node_modules", "dist"]
}
